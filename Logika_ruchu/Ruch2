# --- live_detector_async.py ---
import os
import cv2 as cv
import numpy as np
import tensorflow as tf
import chess
import time
import threading

# === PARAMETRY ===
CAMERA_INDEX = 0
OUTPUT_SIZE = (512, 512)
MODEL_PATH = "models/field_classifier_final_balanced.keras"
CLASS_NAMES = ["empty", "white", "black"]
ANALYSIS_INTERVAL = 2.0  # sekundy pomiędzy analizami

# === STAN GLOBALNY ===
latest_state = None
prev_state = None
board = chess.Board()
lock = threading.Lock()
stop_flag = False

# === INICJALIZACJA ===
model = tf.keras.models.load_model(MODEL_PATH)
cap = cv.VideoCapture(CAMERA_INDEX)
if not cap.isOpened():
    print("❌ Kamera niedostępna.")
    exit()

points, transform_ready, M = [], False, None
vertical_lines, horizontal_lines = [], []
mode = 'none'
warped = None

# --- WYBÓR ROGÓW ---
def select_corner(event, x, y, flags, param):
    global points, transform_ready, M
    if event == cv.EVENT_LBUTTONDOWN and not transform_ready:
        points.append((x, y))
        print(f"Punkt {len(points)}: {x},{y}")
        if len(points) == 4:
            pts1 = np.float32(points)
            pts2 = np.float32([[0, 0], [OUTPUT_SIZE[0], 0],
                               [OUTPUT_SIZE[0], OUTPUT_SIZE[1]], [0, OUTPUT_SIZE[1]]])
            M = cv.getPerspectiveTransform(pts1, pts2)
            transform_ready = True
            print(" Wybrano 4 punkty — plansza wyprostowana.")

# --- WYBÓR LINII ---
def select_point(event, x, y, flags, param):
    global mode, vertical_lines, horizontal_lines, warped
    if warped is None:
        return
    if event == cv.EVENT_LBUTTONDOWN:
        if mode == 'vertical':
            vertical_lines.append((x, y))
        elif mode == 'horizontal':
            horizontal_lines.append((x, y))

def draw_grid(frame, v_lines, h_lines):
    v_lines = sorted(v_lines, key=lambda p: p[0])
    h_lines = sorted(h_lines, key=lambda p: p[1])
    grid = frame.copy()
    for p in v_lines:
        cv.line(grid, (p[0], 0), (p[0], grid.shape[0]), (0, 0, 255), 2)
    for p in h_lines:
        cv.line(grid, (0, p[1]), (grid.shape[1], p[1]), (0, 0, 255), 2)
    return grid

cv.namedWindow("Kamera")
cv.setMouseCallback("Kamera", select_corner)

# --- FUNKCJE ---
def analyze_board_with_model(warped_img, v_lines, h_lines):
    """Analiza całej planszy (64 pola) + zapis debug_tiles
       Kamera: widok z góry, a1 = lewy dolny róg, białe figury u dołu."""

    v = sorted(v_lines, key=lambda p: p[0])  # kolumny: a–h (lewa→prawa)
    h = sorted(h_lines, key=lambda p: p[1])  # wiersze: 8–1 (góra→dół)

    if len(v) != 9 or len(h) != 9:
        return {}

    tiles, coords = [], []

    # iterujemy po rzędach OD DOŁU do GÓRY (rząd 1 → 8)
    for r in range(8):
        y1, y2 = int(h[r][1]), int(h[r + 1][1])
        for c in range(8):
            x1, x2 = int(v[c][0]), int(v[c + 1][0])
            tile = warped_img[y1:y2, x1:x2]
            tile = cv.cvtColor(tile, cv.COLOR_BGR2RGB)
            tile = cv.resize(tile, (128, 128)).astype(np.float32) / 255.0
            tiles.append(tile)
            # poprawne nazewnictwo: r=0 -> rząd 8, r=7 -> rząd 1
            sq = f"{chr(ord('a') + c)}{r + 1}"
            coords.append(sq)

    # --- zapis debug_tiles z nazwami pól ---
    save_dir = "debug_tiles"
    os.makedirs(save_dir, exist_ok=True)
    for tile_debug, sq in zip(tiles, coords):
        out = (tile_debug * 255).astype(np.uint8)
        out = cv.cvtColor(out, cv.COLOR_RGB2BGR)
        cv.imwrite(os.path.join(save_dir, f"{sq}.jpg"), out)
    print("💾 Zapisano 64 pola do folderu debug_tiles (z nazwami pól)")
    
    # --- DEBUG: zapisz wszystkie 64 pola (1 cykl analizy)
    save_dir = "debug_tiles"
    os.makedirs(save_dir, exist_ok=True)

# iterujemy po rzędach 8→1 (żeby pliki odpowiadały rzeczywistej geometrii)
    for rank in range(8, 0, -1):       # 8,7,...,1
        for file_idx, file_char in enumerate("abcdefgh"):
            sq = f"{file_char}{rank}"
            idx = coords.index(sq) if sq in coords else None
            if idx is not None:
                tile_debug = tiles[idx]
                out = (tile_debug * 255).astype(np.uint8)
                out = cv.cvtColor(out, cv.COLOR_RGB2BGR)
                filename = f"{sq}.jpg"
                cv.imwrite(os.path.join(save_dir, filename), out)

                print("💾 Zapisano 64 pola do folderu debug_tiles (z nazwami pól i poprawną orientacją)")

    # --- predykcja ---
    preds = model.predict(np.stack(tiles), verbose=0)
    labels = [CLASS_NAMES[np.argmax(p)] for p in preds]

    # --- słownik pól ---
    fields = {sq: lbl for sq, lbl in zip(coords, labels)}
    return fields



def detect_move(before, after):
    """Porównanie dwóch stanów i zwrócenie ruchu UCI"""
    from_sq, to_sq = None, None
    for sq in before:
        if before[sq] != after[sq]:
            if after[sq] == "empty" and before[sq] != "empty":
                from_sq = sq
            elif before[sq] == "empty" and after[sq] != "empty":
                to_sq = sq
    return f"{from_sq}{to_sq}" if from_sq and to_sq else None

# --- OBSŁUGA WĄTKU PREDYKCJI ---
def prediction_loop():
    global latest_state, prev_state, board, stop_flag
    print("▶️ Asynchroniczne przewidywanie co 2 sekundy uruchomione.")
    while not stop_flag:
        time.sleep(ANALYSIS_INTERVAL)
        if not transform_ready or len(vertical_lines) != 9 or len(horizontal_lines) != 9:
            continue

        # robimy bezpieczną kopię bieżącej klatki
        with lock:
            img_copy = None if warped is None else warped.copy()
        if img_copy is None:
            continue

        # predykcja
        state = analyze_board_with_model(img_copy, vertical_lines, horizontal_lines)
        if not state:
            continue

        # porównanie z poprzednim stanem
        if prev_state is not None:
            move = detect_move(prev_state, state)
            if move:
                mv = chess.Move.from_uci(move)
                if mv in board.legal_moves:
                    board.push(mv)
                    print("♟️  Wykryto i wykonano ruch:", mv)
                    print(board)
                else:
                    print("❌  Ruch nielegalny wg python-chess:", mv)

        # zapis aktualnego stanu jako poprzedni
        prev_state = state

        # --- log kontrolny ---
        # sortuj pola kolejno: a8→h8, ... a1→h1, żeby łatwiej śledzić poprawność
        sorted_state = dict(sorted(state.items(), key=lambda x: (8 - int(x[0][1]), x[0][0])))

        print("INFO: analiza wykonana, liczba pól:", len(state))
        first_row = [sq for sq in sorted_state if sq.endswith("1")]
        last_row = [sq for sq in sorted_state if sq.endswith("8")]

        # pokaż kilka pól z dołu i z góry planszy
        print("Dolny rząd (1):", [(sq, sorted_state[sq]) for sq in first_row])
        print("Górny rząd (8):", [(sq, sorted_state[sq]) for sq in last_row])

# --- GŁÓWNA PĘTLA KAMERY ---
print("Sterowanie: [v] - pionowe, [h] - poziome, [q] - start")

predict_thread = None

while True:
    ret, frame = cap.read()
    if not ret:
        break
    for p in points:
        cv.circle(frame, p, 5, (0, 255, 0), -1)
    if transform_ready and M is not None:
        warped = cv.warpPerspective(frame, M, OUTPUT_SIZE)
        if len(vertical_lines) > 0 or len(horizontal_lines) > 0:
            grid = draw_grid(warped, vertical_lines, horizontal_lines)
            cv.imshow("Zaznacz linie", grid)
        else:
            cv.imshow("Zaznacz linie", warped)
    cv.imshow("Kamera", frame)
    key = cv.waitKey(1) & 0xFF
    if key == ord('v'):
        mode = 'vertical'
        cv.setMouseCallback("Zaznacz linie", select_point)
        print("🟩 Klikaj 9 pionowych linii.")
    elif key == ord('h'):
        mode = 'horizontal'
        cv.setMouseCallback("Zaznacz linie", select_point)
        print("🟦 Klikaj 9 poziomych linii.")
    elif key == ord('q'):
        print("▶️ Start analizy w tle...")
        if predict_thread is None:
            predict_thread = threading.Thread(target=prediction_loop, daemon=True)
            predict_thread.start()
        break

# --- PETLA ŻYWEGO PODGLĄDU ---
while True:
    ret, frame = cap.read()
    if not ret:
        break
    warped = cv.warpPerspective(frame, M, OUTPUT_SIZE)
    with lock:
        copy_for_thread = warped.copy()
    cv.imshow("Podglad", copy_for_thread)
    key = cv.waitKey(1) & 0xFF
    if key == ord('q'):
        stop_flag = True
        break

cap.release()
cv.destroyAllWindows()
print("🛑 Zatrzymano analizę.")